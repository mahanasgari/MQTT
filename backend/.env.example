ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://smartplug:smartplug@localhost:5433/smartplug
SECRET_KEY=change-me-to-a-random-string-with-at-least-32-chars
CORS_ORIGINS=*
LOG_LEVEL=INFO

# MQTT broker (Mosquitto on VPS)
MQTT_BROKER_HOST=your-vps-ip-or-hostname
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=smartplug-backend
MQTT_USERNAME=
MQTT_PASSWORD=

# Device provisioning
REQUIRE_PREREGISTERED_SERIAL=false
PAIRING_TOKEN_PROVISION_TTL_HOURS=24

# Platform admin phones (comma-separated E.164)
PLATFORM_ADMIN_PHONES=
