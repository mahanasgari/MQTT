# --- Docker Compose (root) ---
POSTGRES_USER=smartplug
POSTGRES_PASSWORD=smartplug
POSTGRES_DB=smartplug

# API
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-string-with-at-least-32-chars
CORS_ORIGINS=*
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://smartplug:smartplug@localhost:5433/smartplug

# --- MQTT modes ---
# LOCAL (Docker):  docker compose --profile local-mqtt -f docker-compose.yml -f docker-compose.local-mqtt.yml up -d
#   API uses broker hostname "mosquitto" inside compose network
#
# REMOTE (VPS):    docker compose -f docker-compose.yml -f docker-compose.remote-mqtt.yml up -d
#   Set MQTT_BROKER_HOST to your VPS IP (e.g. 46.31.79.157)

MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=smartplug-backend
MQTT_USERNAME=smartplug-backend
MQTT_PASSWORD=devpass
# Optional firmware MQTT user (Docker broker)
MQTT_DEVICE_PASSWORD=devicepass

# Device provisioning
REQUIRE_PREREGISTERED_SERIAL=false
PAIRING_TOKEN_PROVISION_TTL_HOURS=24

# Platform admin (comma-separated E.164 phones)
PLATFORM_ADMIN_PHONES=+989120000000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
NEXT_PUBLIC_DEFAULT_LOCALE=fa
